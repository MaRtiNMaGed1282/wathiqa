# Wathiqa production configuration
NODE_ENV=production
PORT=5000

# Required secrets. Generate unique, high-entropy values for each deployment.
JWT_SECRET=replace-with-a-long-random-secret
LICENSE_SECRET=replace-with-a-long-random-secret

# Optional comma-separated browser origins. Electron file:// requests do not require an origin entry.
# Example:
# CORS_ORIGIN=http://localhost:5500,https://wathiqa.example.com
