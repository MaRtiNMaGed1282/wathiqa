{
  "name": "wathiqa",
  "version": "1.0.0",
  "main": "electron/main.js",
  "scripts": {
    "desktop": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.wathiqa.desktop",
    "productName": "Wathiqa",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "frontend/**/*",
      "backend/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "mysql2": "^3.16.0",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2"
  }
}
