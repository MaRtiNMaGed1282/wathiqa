{
  "name": "wathiqa",
  "version": "1.0.0",
  "description": "Wathiqa Law Management System",
  "author": "Wathiqa",
  "main": "electron/main.js",
  "scripts": {
    "desktop": "electron .",
    "prepare-client": "node backend/scripts/prepare-client-release.js",
    "build": "electron-builder",
    "office-setup": "electron electron/setup-main.js",
    "build:office-setup": "electron-builder --config electron-builder.setup.json"
  },
  "build": {
    "appId": "com.wathiqa.desktop",
    "productName": "Wathiqa",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "frontend/**/*",
      "backend/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "database",
        "to": "database"
      },
      {
        "from": "assets/wathiqa.ico",
        "to": "assets/wathiqa.ico"
      },
      {
        "from": ".env",
        "to": ".env"
      }
    ],
    "asar": true,
    "npmRebuild": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/wathiqa.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Wathiqa"
    }
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "bidi-js": "^1.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "harfbuzzjs": "^1.4.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "pdfkit": "^0.17.2",
    "qrcode-generator": "^2.0.4",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.1",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2",
    "tailwindcss": "^4.3.1"
  }
}
