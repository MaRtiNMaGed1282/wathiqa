{
  "name": "wathiqa",
  "version": "1.0.0",
  "description": "Wathiqa Law Management System",
  "author": "Wathiqa",
  "main": "electron/main.js",
  "scripts": {
    "desktop": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.wathiqa.desktop",
    "productName": "Wathiqa",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "frontend/**/*",
      "backend/**/*",
      "database/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "database",
        "to": "database"
      },
      {
        "from": ".env",
        "to": ".env"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/wathiqa.ico"
    }
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "bidi-js": "^1.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "harfbuzzjs": "^1.4.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "pdfkit": "^0.17.2",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.1",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2",
    "tailwindcss": "^4.3.1"
  }
}
