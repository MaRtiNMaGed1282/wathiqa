{
  "appId": "com.wathiqa.server",
  "productName": "Wathiqa Server",
  "directories": {
    "output": "dist-server",
    "buildResources": "assets"
  },
  "artifactName": "Wathiqa-Server-Installer-${version}-${arch}.${ext}",
  "files": [
    "electron/**/*",
    "frontend/**/*",
    "backend/**/*",
    "node_modules/**/*",
    "package.json",
    "assets/wathiqa.ico"
  ],
  "extraResources": [
    { "from": "database", "to": "database" },
    { "from": "assets/wathiqa.ico", "to": "assets/wathiqa.ico" }
  ],
  "asar": true,
  "npmRebuild": true,
  "win": {
    "target": [{ "target": "nsis", "arch": ["x64"] }],
    "icon": "assets/wathiqa.ico",
    "artifactName": "Wathiqa-Server-Installer-${version}-${arch}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Wathiqa Server",
    "deleteAppDataOnUninstall": false,
    "installerLanguages": ["en_US"],
    "language": 1033
  }
}
