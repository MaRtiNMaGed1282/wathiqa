{
  "appId": "com.wathiqa.office-setup",
  "productName": "Wathiqa Office Setup",
  "extraMetadata": { "main": "electron/setup-main.js" },
  "directories": { "output": "dist-office-setup" },
  "files": [
    "electron/setup-main.js",
    "electron/setup-preload.js",
    "electron/deployment-config.js",
    "electron/device-identity.js",
    "electron/setup-ui/**/*",
    "assets/wathiqa.ico",
    "package.json",
    "node_modules/qrcode-generator/**/*"
  ],
  "asar": true,
  "npmRebuild": false,
  "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "assets/wathiqa.ico" },
  "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true, "shortcutName": "Wathiqa Office Setup", "artifactName": "Wathiqa-Office-Setup-Installer.${ext}" }
}
