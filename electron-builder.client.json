{
  "appId": "com.wathiqa.client",
  "productName": "Wathiqa Client",
  "directories": {
    "output": "dist-client",
    "buildResources": "assets"
  },
  "artifactName": "Wathiqa-Client-Installer-${version}-${arch}.${ext}",
  "files": [
    "electron/main.js",
    "electron/preload.js",
    "electron/deployment-config.js",
    "electron/device-identity.js",
    "electron/connection-monitor.js",
    "electron/version-compatibility.js",
    "frontend/**/*",
    "assets/wathiqa.ico",
    "package.json"
  ],
  "extraResources": [],
  "asar": true,
  "npmRebuild": false,
  "win": {
    "target": [{ "target": "nsis", "arch": ["x64"] }],
    "icon": "assets/wathiqa.ico",
    "artifactName": "Wathiqa-Client-Installer-${version}-${arch}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Wathiqa Client",
    "deleteAppDataOnUninstall": false,
    "installerLanguages": ["en_US"],
    "language": 1033
  }
}
